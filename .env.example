# Optional: copy to .env and restart npm run dev after changing settings.
# No pip packages or separate Python server are required.
# Windows defaults to python; macOS/Linux defaults to python3.
# SCHEDULE_PYTHON=C:/Python312/python.exe

SCHEDULE_PERIOD_ID=241
SCHEDULE_PERIOD_LABEL=2026/2027
SCHEDULE_FIRST_MONDAY=2026-08-31
SCHEDULE_TIMEZONE=Asia/Yekaterinburg
SCHEDULE_TTL=86400
SCHEDULE_CATALOG_TTL=86400
SCHEDULE_UPSTREAM_TIMEOUT=30
# SCHEDULE_DATABASE=.runtime/schedule/schedule.sqlite3
# UUST_API_BASE=https://dev.uust-time.ru/api/v/852972
# SCHEDULE_OFFLINE=1

# Аккаунты и общий форум. Пользовательская база не входит в архив.
CAMPUS_EMAIL_DOMAINS=stud.uust.ru
# Для закрытого тестирования: вход только по заранее выданным аккаунтам, без SMTP.
# CAMPUS_REGISTRATION_ENABLED=false
# Только для npm run dev: фиксированный код без отправки письма.
# CAMPUS_TEST_EMAIL_CODE=123456
# Для тестирования с любой почтой замените значение на *.
# CAMPUS_DATA_DIR=.runtime/campus
# Регистрация с письмом: заполните все поля. Секрет: 64 случайных hex-символа,
# например результат `openssl rand -hex 32`. Не используйте пароль от почты студента.
# CAMPUS_SMTP_HOST=smtp.example.org
# CAMPUS_SMTP_PORT=587
# CAMPUS_SMTP_SECURE=false
# CAMPUS_SMTP_USER=sender@example.org
# CAMPUS_SMTP_PASSWORD=your-smtp-app-password
# CAMPUS_MAIL_FROM=PocketUUST <sender@example.org>
# CAMPUS_EMAIL_CODE_SECRET=64_hex_characters
# При размещении за HTTPS-прокси укажите публичный адрес:
# CAMPUS_PUBLIC_ORIGIN=https://campus.example.org
# NODE_ENV=production

# Помощник: локальная модель Ollama (нужны ollama serve и ollama pull qwen3:4b-instruct).
ASSISTANT_PROVIDER=ollama
ASSISTANT_MODEL=qwen3:4b-instruct
# ASSISTANT_TIMEOUT_MS=90000
# ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Вариант с внешним API: ASSISTANT_PROVIDER=openai, ASSISTANT_MODEL=gpt-4.1-mini
# ASSISTANT_API_KEY=...  (только в .env сервера, не VITE_*)
# Без генерации, только поиск: ASSISTANT_PROVIDER=off
